# Local data directory for file downloads (SOR, SKS, etc.). Not set here for the
# same reason as PYTHONPATH above: the devcontainer supplies it, and core/org_config.py
# carries the same value as its default. Override it per deployment, not per developer.

# Publisher stamped on published FHIR CodeSystem resources (the organization
# publishing the terminology, not the software). Override per deployment.
FHIR_PUBLISHER=Your Organization

# ---------------------------------------------------------------------------
# SilkeborgData — leverance-share
# ---------------------------------------------------------------------------
# Read-only SMB-mount, der KUN findes i et deployment, som leverer stien —
# samme /mnt/ftproot-mount som HAIBA og DRG bruger:
#   SILKEBORGDATA_BASE_DIR=/mnt/ftproot/LØN/arkiv/E26
# Lad den være tom lokalt: en tom, ikke-eksisterende ELLER tom mappe SKAL fejle
# højlydt, og den lokale devcontainer har ingen adgang til drevet.
# Sæt den kun lokalt, hvis du arbejder mod en manuel kopi.
SILKEBORGDATA_BASE_DIR=
# DOS-Nordic. Bekræftes på data ved første load; HAIBA på samme mount er cp1252,
# så de to må ALDRIG dele konstant.
SILKEBORGDATA_FILE_ENCODING=cp865

# ---------------------------------------------------------------------------
# SDS file-drop sources (DSI/csv_files) — read-only CIFS mounts, injected per
# allocation by the deployment. Deliberately no default in code AND no value
# here: an unset variable is a hard failure, so "share not mounted" can never
# look like "no new deliveries". The commented line documents the expected
# path only. The encoding has a real default in code (cp1252).
# ---------------------------------------------------------------------------
# Folder of the deliveries of each SDS source, and the encoding of its files.
# UDREDNINGSRET_BASE_DIR=/mnt/ftproot/Udredningsret
UDREDNINGSRET_FILE_ENCODING=cp1252
# CPR_BASE_DIR=<source-folder>
CPR_FILE_ENCODING=cp1252
# DRG_BASE_DIR=<source-folder>
DRG_FILE_ENCODING=cp1252
# HAIBA_BASE_DIR=<source-folder>
HAIBA_FILE_ENCODING=cp1252
# SAFETYNET_BASE_DIR=<source-folder>
# KRAEFTMONITORERING_BASE_DIR=<source-folder>
# VENTETIDER_BASE_DIR=<source-folder>
# LPRLISTER_BASE_DIR=<source-folder>
# APOVISION_BASE_DIR=<source-folder>
# SDS_TIP_BASE_DIR=<source-folder>

# ---------------------------------------------------------------------------
# OS2mo / Magenta GraphQL integration
#
# The delivered codesystems (SOR, Okosted, ...) are uploaded to Magenta's OS2mo
# once a day as full-load CSV files (GraphQL upload_file), and OS2mo's
# organisation is read back into the warehouse.
#
# In production, set these in the deployment, exactly like the database
# connections. The secret never lives in a repo.
# For the devcontainer they stay empty and OS2MO_ENABLED stays false, so no
# developer machine can write to Magenta by accident; the export and its CSV
# still build and can be run with dry_run=true.
#
# OS2MO_BASE_URL is the OS2mo root WITHOUT the /graphql path. The version is
# pinned per the contract: the unversioned endpoint follows whatever OS2mo
# currently ships and is rejected by the client.
#
# OS2MO_KEYCLOAK_REALM_URL is the Keycloak REALM root, e.g.
# https://<host>/auth/realms/mo. The token endpoint is read from that realm's
# .well-known/openid-configuration rather than assembled here — the /auth
# prefix moved in Keycloak 17, so the path is a version detail the server can
# answer for itself.
# ---------------------------------------------------------------------------
# true: the daily upload to OS2mo runs.
OS2MO_ENABLED=false
# OS2mo root URL, GraphQL version, Keycloak realm and client credentials.
OS2MO_BASE_URL=
OS2MO_GRAPHQL_VERSION=v30
OS2MO_KEYCLOAK_REALM_URL=
OS2MO_CLIENT_ID=
OS2MO_CLIENT_SECRET=

# Folder of the LPR3 deliveries from SDS, and the encoding of the files.
# LPR3_BASE_DIR=/mnt/ftproot/SDS_NGC_Sundhedsdata_LPR_Grunddata/Fra-SDS
LPR3_FILE_ENCODING=cp1252

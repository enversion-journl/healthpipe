# ---------------------------------------------------------------------------
# Root .env — copy this file: `cp .env.template .env`
#
# This file is injected into the devcontainer / fhir-server containers via
# `env_file: ../.env` in .devcontainer/docker-compose.yml. It supplies the
# APPLICATION connection variables (the Dagster pipelines read these).
#
# NOTE: this file does NOT feed `${VAR:-default}` interpolation in
# docker-compose.yml. Compose interpolates from `.devcontainer/.env` (the
# devcontainer's project dir) or the shell. The DB containers therefore run on
# the docker-compose defaults unless you override them in `.devcontainer/.env`
# (see `.devcontainer/.env.template`). The values below mirror those defaults so
# `cp .env.template .env` yields a coherent stack (aside from AIDBOX_LICENSE).
# ---------------------------------------------------------------------------

# Postgres (Dagster metadata store)
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db

# FHIR server database (Aidbox backing Postgres)
FHIR_SERVER_DB_USER=postgres_user
FHIR_SERVER_DB_PASSWORD=postgres_password
FHIR_SERVER_DB_DATABASE=aidbox

# Aidbox FHIR server
AIDBOX_CLIENT_SECRET=secret
AIDBOX_ADMIN_PASSWORD=secret

# MSSQL container
MSSQL_USERNAME=sa
MSSQL_SA_PASSWORD=tempPassword1!
MSSQL_STAGING_DB=staging
MSSQL_DSO_DB=dso
MSSQL_ILS_DB=ils
MSSQL_COSMIC_DB=cosmic
MSSQL_MYSUPPLY_DB=mysupply
MSSQL_SYDAX_DB=sydax

# Oracle IFDB container
ORACLE_PASSWORD=tempPassword1!
ORACLE_DATABASE=ORACLE_DB
APP_USER=myuser
APP_USER_PASSWORD=tempPassword1!

# ---------------------------------------------------------------------------
# Application connection variables
# ---------------------------------------------------------------------------

# Staging Database (DSI/DSA Layer)
MSSQL_SOURCE_STAGING_HOST=mssql
MSSQL_SOURCE_STAGING_PORT=1433
MSSQL_SOURCE_STAGING_DB=staging
MSSQL_SOURCE_STAGING_USER=sa
MSSQL_SOURCE_STAGING_PASSWORD=tempPassword1!

MSSQL_TARGET_STAGING_HOST=mssql
MSSQL_TARGET_STAGING_PORT=1433
MSSQL_TARGET_STAGING_DB=staging
MSSQL_TARGET_STAGING_USER=sa
MSSQL_TARGET_STAGING_PASSWORD=tempPassword1!

# DSO Database (Reporting Layer) - separate database on same server
MSSQL_SOURCE_DSO_HOST=mssql
MSSQL_SOURCE_DSO_PORT=1433
MSSQL_SOURCE_DSO_DB=dso
MSSQL_SOURCE_DSO_USER=sa
MSSQL_SOURCE_DSO_PASSWORD=tempPassword1!

MSSQL_TARGET_DSO_HOST=mssql
MSSQL_TARGET_DSO_PORT=1433
MSSQL_TARGET_DSO_DB=dso
MSSQL_TARGET_DSO_USER=sa
MSSQL_TARGET_DSO_PASSWORD=tempPassword1!

# Database Configuration
MYSUPPLY_PROD_MSSQL_SERVER=mssql
MYSUPPLY_PROD_MSSQL_USERNAME=sa
MYSUPPLY_PROD_MSSQL_PASSWORD=tempPassword1!
MYSUPPLY_PROD_MSSQL_DATABASE=mysupply
MYSUPPLY_PROD_MSSQL_SCHEMA=dbo
MYSUPPLY_PROD_MSSQL_PORT=1433


# Sydax database + 2 different schemas
SYDAX_PROD_MSSQL_USERNAME=sa
SYDAX_PROD_MSSQL_PASSWORD=tempPassword1!
SYDAX_PROD_MSSQL_SERVER=mssql
SYDAX_PROD_MSSQL_DATABASE=sydax
SYDAX_PROD_MSSQL_SCHEMA_FINANS=Finans
SYDAX_PROD_MSSQL_SCHEMA_KREDITOR=Kreditor
SYDAX_PROD_MSSQL_PORT=1433


# ILS Database
ILS_PROD_MSSQL_SERVER=mssql
ILS_PROD_MSSQL_USERNAME=sa
ILS_PROD_MSSQL_PASSWORD=tempPassword1!
ILS_PROD_MSSQL_SCHEMA=dbo
ILS_PROD_MSSQL_DATABASE=ils
ILS_PROD_MSSQL_PORT=1433


# Cosmic Database
COSMIC_PROD_MSSQL_SERVER=mssql
COSMIC_PROD_MSSQL_USERNAME=sa
COSMIC_PROD_MSSQL_PASSWORD=tempPassword1!
COSMIC_PROD_MSSQL_DATABASE=cosmic
COSMIC_PROD_MSSQL_SCHEMA=ca
COSMIC_PROD_MSSQL_PORT=1433


# IFDB Database
IFDB_PROD_ORACLE_SERVER=oracle
IFDB_PROD_ORACLE_DATABASE=ORACLE_DB  # SID
IFDB_PROD_ORACLE_USERNAME=myuser
IFDB_PROD_ORACLE_PASSWORD=tempPassword1!
IFDB_PROD_ORACLE_PORT=1521
IFDB_PROD_ORACLE_SCHEMA=IFDB


USE_REAL_DB_FOR_TESTS=true
USE_FHIR_API=true

# Aidbox license JWT for the local FHIR server (fhir-server / aidboxone container).
# Optional: the FHIR server runs in dev mode (AIDBOX_DEV_MODE) without a license.
# Set it only if your Aidbox build/features require one; obtain from the Aidbox portal / team secret store.
# Injected into the container via env_file (../.env) in .devcontainer/docker-compose.yml — never hardcode it there.
AIDBOX_LICENSE=

FHIR_SERVER_URL=http://fhir-server:8888
FHIR_CLIENT_USERNAME=root
FHIR_CLIENT_PASSWORD=secret

PG_FHIR_DATABASE=aidbox
PG_FHIR_USER=postgres_user
PG_FHIR_PASSWORD=postgres_password

# These will be populated by NOMAD when spinning up servers in production
PG_FHIR_HOST=fhir-server-db
PG_FHIR_PORT=5432


# Dagster configuration
DAGSTER_POSTGRES_USER=postgres_user
DAGSTER_POSTGRES_PASSWORD=postgres_password
DAGSTER_POSTGRES_DB=postgres_db
DAGSTER_POSTGRES_HOST=postgres
DAGSTER_POSTGRES_PORT=5432
DAGSTER_BETA_WARNINGS=0

# Linked Server configuration
MSSQL_LINKED_SERVER_HOST=mssql
MSSQL_LINKED_SERVER_PORT=1433
MSSQL_LINKED_SERVER_DB=DW
MSSQL_LINKED_SERVER_USER=sa
MSSQL_LINKED_SERVER_PASSWORD=tempPassword1!
MSSQL_LINKED_SERVER_NAME=STAGING_LINK

# PYTHONPATH is deliberately NOT set here. It is a non-secret path tied to the
# container layout, so the devcontainer owns it (.devcontainer/docker-compose.yml,
# next to the mount) and the production images set it in their Dockerfile. Setting
# it in this file produced .env copies that kept pointing at the old workspace path
# after a rename, which broke `dagster definitions validate` in fresh clones.

PORT=3000
LOG_LEVEL=info
PYTHONWARNINGS=ignore:.*observable_source_asset.*

# ---------------------------------------------------------------------------
# Organization-specific configuration (core/org_config.py)
# ---------------------------------------------------------------------------

# Local data directory for file downloads (SOR, SKS, etc.). Not set here for the
# same reason as PYTHONPATH above: the devcontainer supplies it, and core/org_config.py
# carries the same value as its default. Override it per deployment, not per developer.

# Publisher stamped on published FHIR CodeSystem resources (the organization
# publishing the terminology, not the software). Override per deployment.
FHIR_PUBLISHER=Your Organization

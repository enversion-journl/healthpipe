# ---------------------------------------------------------------------------
# .devcontainer/.env  — OPTIONAL docker-compose interpolation overrides
#
# Copy to `.devcontainer/.env` to override the ${VAR:-default} values used in
# .devcontainer/docker-compose.yml:
#   cp .devcontainer/.env.template .devcontainer/.env
#
# This is the file Docker Compose reads for `${VAR}` interpolation, because the
# devcontainer's compose project directory is `.devcontainer/`. It is OPTIONAL:
# with no file (or every line left commented), the docker-compose defaults shown
# below apply and the stack runs. The root `.env` (from ../.env.template) is a
# DIFFERENT file — it is injected into the app container via `env_file` and does
# NOT affect ${VAR} interpolation.
#
# Each variable is listed with its docker-compose default. Uncomment and edit
# only the ones you want to change.
# ---------------------------------------------------------------------------

# --- Database container images -----------------------------------------------
# Point these at your own images (e.g. preloaded with test data). MSSQL should
# mirror production: full SQL Server 2022 on linux/amd64 (EngineEdition 3). On
# Apple Silicon this runs via Rosetta — keep linux/amd64. Do NOT use
# linux/arm64: it resolves to Azure SQL Edge (EngineEdition 9), which OOMs under
# load and lacks linked-server parity (verified in poc-mssql-2025).
# Requires Docker Desktop with "Use Virtualization Framework" + Rosetta enabled.
#MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
#MSSQL_PLATFORM=linux/amd64
# Cap SQL Server buffer pool (MB). 1024 leaves room for Oracle/Postgres/Aidbox
# within a 9-10 GB Docker Desktop VM. Raise if you've allocated >=16 GB.
#MSSQL_MEMORY_LIMIT_MB=1024
#ORACLE_IMAGE=gvenzl/oracle-free:full-faststart

# --- Postgres (Dagster metadata store) ---------------------------------------
#POSTGRES_USER=postgres_user
#POSTGRES_PASSWORD=postgres_password
#POSTGRES_DB=postgres_db

# --- FHIR server database (Aidbox backing Postgres) --------------------------
#FHIR_SERVER_DB_USER=postgres_user
#FHIR_SERVER_DB_PASSWORD=postgres_password
#FHIR_SERVER_DB_DATABASE=aidbox

# --- Aidbox FHIR server ------------------------------------------------------
#AIDBOX_CLIENT_SECRET=secret
#AIDBOX_ADMIN_PASSWORD=secret
#FHIR_CLIENT_USERNAME=root
#FHIR_CLIENT_PASSWORD=secret

# --- MSSQL container ---------------------------------------------------------
#MSSQL_USERNAME=sa
#MSSQL_SA_PASSWORD=tempPassword1!
#MSSQL_STAGING_DB=staging
#MSSQL_DSO_DB=dso
#MSSQL_ILS_DB=ils
#MSSQL_COSMIC_DB=cosmic
#MSSQL_MYSUPPLY_DB=mysupply
#MSSQL_SYDAX_DB=sydax

# --- Oracle IFDB container ---------------------------------------------------
#ORACLE_PASSWORD=tempPassword1!
#ORACLE_DATABASE=ORACLE_DB
#APP_USER=myuser
#APP_USER_PASSWORD=tempPassword1!

{
  "resourceType": "ViewDefinition",
  "name": "procedure_view",
  "resource": "Procedure",
  "status": "active",
  "select": [
    {
      "column": [
        {
          "name": "procedure_id",
          "path": "id"
        },
        {
          "name": "patient_id",
          "path": "subject.id"
        },
        {
          "name": "encounter_id",
          "path": "encounter.id.first()"
        },
        {
          "name": "episode_of_care_id",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/episodeOfCare').valueReference.id.first()"
        },
        {
          "name": "status",
          "path": "status"
        },
        {
          "name": "category_code",
          "path": "category.coding.code.first()"
        },
        {
          "name": "category_display",
          "path": "category.coding.display.first()"
        },
        {
          "name": "code",
          "path": "code.coding.where(userSelected = true).code.first()"
        },
        {
          "name": "code_system",
          "path": "code.coding.where(userSelected = true).system.first()"
        },
        {
          "name": "code_display",
          "path": "code.coding.where(userSelected = true).display.first()"
        },
        {
          "name": "performed_datetime",
          "path": "performedDateTime"
        },
        {
          "name": "performed_period_start",
          "path": "performedPeriod.start"
        },
        {
          "name": "performed_period_end",
          "path": "performedPeriod.end"
        },
        {
          "name": "body_site_code",
          "path": "bodySite.coding.code.first()"
        },
        {
          "name": "source_system",
          "path": "identifier.system.first()"
        },
        {
          "name": "source_identifier_value",
          "path": "identifier.value.first()"
        },
        {
          "name": "ifdb_aktivitet_id",
          "path": "identifier.where(system='urn:source:ifdb:aktivitetsresultat_procedure').value.first()"
        },
        {
          "name": "knivtid_start",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/aktivitetsresultatProcedureSourceMeta').extension.where(url='knivtidStart').valueDateTime.first()"
        },
        {
          "name": "knivtid_slut",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/aktivitetsresultatProcedureSourceMeta').extension.where(url='knivtidSlut').valueDateTime.first()"
        },
        {
          "name": "knivtid_minutter",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/aktivitetsresultatProcedureSourceMeta').extension.where(url='knivtidMinutter').valueInteger.first()"
        },
        {
          "name": "part_of_id",
          "path": "partOf.id.first()"
        },
        {
          "name": "lpr3_ignored",
          "path": "meta.tag.where(system = 'http://example.org/fhir/CodeSystem/resource-flag' and code = 'lpr3-ignored').exists()"
        },
        {
          "name": "status_code",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureSourceMeta').extension.where(url='statusCode').valueString.first()"
        },
        {
          "name": "status_text",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureSourceMeta').extension.where(url='statusText').valueString.first()"
        },
        {
          "name": "performer_organization_id",
          "path": "performer.where(function.coding.code = 'udfoerende').actor.id.first()"
        },
        {
          "name": "stamafdeling_organization_id",
          "path": "performer.where(function.coding.code = 'stamafdeling').actor.id.first()"
        },
        {
          "name": "practitioner_id",
          "path": "performer.actor.where(type = 'Practitioner').identifier.value.first()"
        },
        {
          "name": "practitioner_display",
          "path": "performer.actor.where(type = 'Practitioner').display.first()"
        },
        {
          "name": "practitioner_role_code",
          "path": "performer.where(actor.type = 'Practitioner').function.coding.code.first()"
        },
        {
          "name": "practitioner_role_display",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureSourceMeta').extension.where(url='userRoleName').valueString.first()"
        },
        {
          "name": "epji_created_at",
          "path": "extension('http://example.org/fhir/StructureDefinition/sourceCreatedAt').valueDateTime.first()"
        },
        {
          "name": "epji_modified_at",
          "path": "extension('http://example.org/fhir/StructureDefinition/sourceModifiedAt').valueDateTime.first()"
        },
        {
          "name": "ifdb_modified_at",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureSourceMeta').extension.where(url='ifdbModifiedAt').valueString.first()"
        },
        {
          "name": "used_contrast_code",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureSourceMeta').extension.where(url='usedContrastCode').valueString.first()"
        },
        {
          "name": "used_contrast_text",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureSourceMeta').extension.where(url='usedContrastText').valueString.first()"
        },
        {
          "name": "staff_category_code",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureSourceMeta').extension.where(url='staffCategoryCode').valueString.first()"
        },
        {
          "name": "dw_is_deleted",
          "path": "extension('urn:fhir:isDeleted').valueInteger.first()"
        },
        {
          "name": "location_code",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureLocationMeta').extension.where(url='code').valueString.first()"
        },
        {
          "name": "location_orgcode",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/procedureLocationMeta').extension.where(url='orgCode').valueString.first()"
        },
        {
          "name": "stamafdeling_kode",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/risYdelseLocationMeta').extension.where(url='stamafdelingKode').valueString.first()"
        },
        {
          "name": "stamafdeling_orgkode",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/risYdelseLocationMeta').extension.where(url='stamafdelingOrgkode').valueString.first()"
        },
        {
          "name": "udfoert_enhed_kode",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/risYdelseLocationMeta').extension.where(url='udfoertEnhedKode').valueString.first()"
        },
        {
          "name": "udfoert_enhed_orgkode",
          "path": "extension.where(url='http://example.org/fhir/StructureDefinition/risYdelseLocationMeta').extension.where(url='udfoertEnhedOrgkode').valueString.first()"
        }
      ]
    }
  ]
}

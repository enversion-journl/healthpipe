# ============================================================================
# TEST ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy to tests/config/test.env and update with your test credentials
# Usage: cp tests/config/test.env.example tests/config/test.env
#
# This file configures testing behavior for integration tests.

# ============================================================================
# RESOURCE SELECTION
# ============================================================================

# Enable real database connections for integration tests
# Set to 'true' to use real test/dev databases (not production!)
USE_REAL_DB_FOR_TESTS=false

# Test environment identifier (dev, test, local - NEVER 'production')
TEST_ENV=local

# Enable writes to real databases (default: false for safety)
# Only enable if you have a dedicated test database
ENABLE_TEST_WRITES=false

# Specific patient ID to use for testing
TEST_PATIENT_ID=12345

# ============================================================================
# REAL DATABASE CONFIGURATION (for integration tests)
# ============================================================================
# These settings are used when USE_REAL_DB_FOR_TESTS=true
# Fallback to main environment variables if not set

# Test FHIR Server
TEST_FHIR_SERVER_URL=http://fhir-server:8888
TEST_FHIR_CLIENT_USERNAME=root
TEST_FHIR_CLIENT_PASSWORD=secret

# ============================================================================
# MYSUPPLY DATABASE
# ============================================================================
MYSUPPLY_PROD_MSSQL_SERVER=mssql
MYSUPPLY_PROD_MSSQL_USERNAME=sa
MYSUPPLY_PROD_MSSQL_PASSWORD=tempPassword1!
MYSUPPLY_PROD_MSSQL_DATABASE=mysupply
MYSUPPLY_PROD_MSSQL_SCHEMA=dbo
MYSUPPLY_PROD_MSSQL_PORT=1433

# ============================================================================
# SYDAX DATABASE
# ============================================================================
SYDAX_PROD_MSSQL_USERNAME=sa
SYDAX_PROD_MSSQL_PASSWORD=tempPassword1!
SYDAX_PROD_MSSQL_SERVER=mssql
SYDAX_PROD_MSSQL_DATABASE=sydax
SYDAX_PROD_MSSQL_SCHEMA_FINANS=Finans
SYDAX_PROD_MSSQL_SCHEMA_KREDITOR=Kreditor
SYDAX_PROD_MSSQL_PORT=1433

# ============================================================================
# ILS DATABASE
# ============================================================================
ILS_PROD_MSSQL_SERVER=mssql
ILS_PROD_MSSQL_USERNAME=sa
ILS_PROD_MSSQL_PASSWORD=tempPassword1!
ILS_PROD_MSSQL_SCHEMA=dbo
ILS_PROD_MSSQL_DATABASE=ils
ILS_PROD_MSSQL_PORT=1433

# ============================================================================
# IFDB ORACLE DATABASE
# ============================================================================
IFDB_PROD_ORACLE_SERVER=oracle
IFDB_PROD_ORACLE_DATABASE=ORACLE_DB
IFDB_PROD_ORACLE_USERNAME=myuser
IFDB_PROD_ORACLE_PASSWORD=tempPassword1!
IFDB_PROD_ORACLE_PORT=1521
IFDB_PROD_ORACLE_SCHEMA=IFDB


USE_REAL_DB_FOR_TESTS=true
FHIR_CLIENT_USERNAME=root
FHIR_CLIENT_PASSWORD=secret
USE_FHIR_API=true

# ============================================================================
# SAFETY CHECKS
# ============================================================================
# The test framework will refuse to use real resources if:
# - TEST_ENV contains "prod" or "production"
# - DAGSTER_ENVIRONMENT contains "prod" or "production"
# - USE_REAL_DB_FOR_TESTS is not explicitly set to "true"
